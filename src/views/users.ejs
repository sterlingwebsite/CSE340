<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <p>Below is a list of all registered users:</p>

  <ul>
    <% users.forEach(user => { %>
      <li>
        <strong><%= user.name %></strong>
        — <%= user.email %>
        — Role: <%= user.role_name %>
      </li>
    <% }) %>
  </ul>

</main>
<%- include('partials/footer') %>
