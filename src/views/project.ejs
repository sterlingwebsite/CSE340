<%- include('partials/header') %>

<main>
  <h1><%= project.title %></h1>

  <div class="category-tags">
    <% categories.forEach(category => { %>
      <a href="/category/<%= category.category_id %>" class="tag">
        <%= category.category_name %>
      </a>
    <% }); %>
  </div>

  <p><%= project.description %></p>

  <ul>
    <li>
      <strong>Date:</strong> 
      <%= new Date(project.project_date).toLocaleDateString('en-US', { 
          month: 'long', 
          day: 'numeric', 
          year: 'numeric' 
      }) %>
    </li>

    <li><strong>Location:</strong> <%= project.location %></li>

    <li>
      <strong>Organization:</strong> 
      <a href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a>
    </li>

    <% if (user && user.role_name === 'admin') { %>
      <li>
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
      </li>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
      <li>
          <a href="/edit-project/<%= project.project_id %>" class="btn-edit">
            Edit Project Details
          </a>
      </li>
    <% } %>
  </ul>
</main>

<%- include('partials/footer') %>