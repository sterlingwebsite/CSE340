<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        
        <%= new Date(project.project_date).toLocaleDateString('en-US', { 
            month: 'long', 
            day: 'numeric', 
            year: 'numeric' 
        }) %>:
        &nbsp;
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>
        &nbsp;
        (<a href="/organization/<%= project.organization_id %>">
          <i><%= project.organization_name %></i>
        </a>)
        
      </li>
    <% }); %>

    <% if (user && user.role_name === 'admin') { %>
      <li>
          <a href="/new-project">Add a New Service Project</a>
      </li>
    <% } %>
  </ul>
</main>
<%- include('partials/footer') %>
